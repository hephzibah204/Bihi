# .env.local.example
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored and safe for local development

# ==================================================
# REQUIRED: Supabase Configuration
# ==================================================
# Get these from: https://app.supabase.com → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ==================================================
# OPTIONAL: AI Services
# ==================================================
# Gemini AI (Google)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Hugging Face
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key

# ==================================================
# OPTIONAL: Server-Side Only (for backend/API)
# ==================================================
# ⚠️ WARNING: Never expose service role key to client!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==================================================
# OPTIONAL: Development Configuration
# ==================================================
VITE_USE_LOCAL_API=false
VITE_LOCAL_API_URL=http://localhost:3001
VITE_AI_FALLBACK_ENABLED=true
VITE_AI_SEMANTIC_CACHE_ENABLED=true

# ==================================================
# OPTIONAL: Demo Mode (runs without Supabase)
# ==================================================
# VITE_DEMO_MODE=true
