# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com

# REQUIRED: Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED: Use publishable key (preferred) OR anon key
# Publishable key (recommended for production)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Legacy anon key (used if publishable key not available)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ SECURITY WARNING ⚠️
# DO NOT put SUPABASE_SERVICE_ROLE_KEY here!
# Service role keys should ONLY be in:
# - Cloudflare Worker environment variables (for production)
# - Server-side environment (for local development)
# Never commit service role keys to version control!

# Optional: Gemini AI API Key for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# --- Backend / Local API Server ---
# Supabase Project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only; NEVER expose on client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Log ingestion endpoint
LOGS_ENDPOINT=

# --- Domain Configuration ---
# Root domains for your deployment (comma-separated)
# Default: reportsheet.com.ng,localhost
VITE_ROOT_DOMAINS=yourdomain.com,localhost

# Preview/development domain
# Default: reportsheet.pages.dev
VITE_PREVIEW_DOMAIN=your-app.pages.dev

# Use subdomains for tenants (true/false)
# true: tenant.yourdomain.com
# false: yourdomain.com/?tenant=tenant
VITE_USE_SUBDOMAINS=true

# Protocol to use (http:/https:)
VITE_PROTOCOL=https:

# --- Development Configuration ---
# Enable local API server proxy (development only)
VITE_USE_LOCAL_API=false

# Local API server URL (if using local proxy)
VITE_LOCAL_API_URL=http://localhost:3001
