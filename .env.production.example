# Production Environment Configuration Template
# Copy this to .env.production and update with your actual values

# ===== REQUIRED PRODUCTION SETTINGS =====

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Domain Configuration
# Replace with your actual production domain(s)
# Include the primary root domain used in production
VITE_ROOT_DOMAINS=reportsheet.com.ng
VITE_PREVIEW_DOMAIN=your-app.pages.dev
VITE_USE_SUBDOMAINS=true
VITE_PROTOCOL=https:

# IMPORTANT: Use the SAME Supabase project for root and wildcard deployments
# Root: reportsheet.com.ng
# Wildcard: *.reportsheet.com.ng
# Both must point to the identical `VITE_SUPABASE_URL` and publishable/anon key.

# ===== OPTIONAL SETTINGS =====

# AI Features (optional)
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
BANANA_API_KEY=your_banana_api_key_here
BANANA_MODEL_KEY=your_banana_model_key_here

# ===== DEVELOPMENT SETTINGS (should be false in production) =====
VITE_USE_LOCAL_API=false

# Supabase Edge Function (optional)
# If set, signup will POST to this function instead of /api/register
# Example: https://<your-project-ref>.supabase.co/functions/v1/register_tenant
VITE_SUPABASE_FUNCTION_REGISTER_URL=

# ===== DEPLOYMENT EXAMPLES =====

# Example 1: Using custom domain with subdomains
# VITE_ROOT_DOMAINS=myschoolapp.com
# VITE_USE_SUBDOMAINS=true
# Result: brightstar.myschoolapp.com

# Example 2: Using single domain with query params
# VITE_ROOT_DOMAINS=myschoolapp.com
# VITE_USE_SUBDOMAINS=false
# Result: myschoolapp.com/?tenant=brightstar

# Example 3: Multiple domains
# VITE_ROOT_DOMAINS=myschoolapp.com,schoolportal.org
# VITE_USE_SUBDOMAINS=true
# Result: Works on both domains with subdomains

# Example 4: Cloudflare Pages deployment
# VITE_ROOT_DOMAINS=myschoolapp.com
# VITE_PREVIEW_DOMAIN=myschoolapp.pages.dev
# Result: Production on myschoolapp.com, previews on pages.dev